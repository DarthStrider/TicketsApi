root = true

# T-011: explicit types instead of var (IDE0008) and target-typed new() (IDE0090), enforced in the build
# through EnforceCodeStyleInBuild in Directory.Build.props. TreatWarningsAsErrors makes them build errors.
# The dotnet_diagnostic lines set the severity the command-line build uses, not only the IDE.
[*.cs]
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

# EF Core migrations are generated, and InitialCreate.cs has no <auto-generated /> header, so mark them here.
[src/TicketsApi/Data/Migrations/**.cs]
generated_code = true
