<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Needed by `dotnet ef`. PrivateAssets keeps it from flowing to referencing projects; its DLL is still in the build output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the tests reach internal types, e.g. the store's test-only concurrency hook (T-003 criterion 24). -->
    <InternalsVisibleTo Include="TicketsApi.Tests" />
  </ItemGroup>
</Project>
